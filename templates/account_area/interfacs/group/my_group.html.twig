{% extends 'layout/account_area.html.twig' %}

{% block body_extra_classes 'with-cards' %}

{% block content %}

	{% include 'interfacs/group/_styles.html.twig' %}

	<style>
		.season-name {
			margin-bottom: 20px;
			color: var(--color-gray-500);
		}
	</style>

	{% if groups is empty %}
		<p>Tu n'es dans aucune poule pour {{ season }}.</p>
	{% else %}
		<p class="season-name">{{ season }}</p>

		<div class="groups">
			{% for group in groups %}
				{% include 'interfacs/group/_card.html.twig' with {
					standings: standings[group.id] ?? [],
					me: app.user.player,
					mine_label: false,
					planning_link: true,
				} %}
			{% endfor %}
		</div>
	{% endif %}

	{% include 'account_area/interfacs/_public_links.html.twig' %}

{% endblock %}

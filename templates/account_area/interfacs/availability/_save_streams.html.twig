{# answer to an autosave of the availability grid: refreshed summaries (same choices as availability/_grid with split) #}
{% set sections = grid.sections %}
<turbo-stream action="replace" target="avail-summary">
    <template>
        {% if sections %}
            {% include 'availability/_grid_summary.html.twig' with {summary: sections.near, label: 'Prochaines dates'} %}
        {% else %}
            {% include 'availability/_grid_summary.html.twig' with {summary: grid.summary} %}
        {% endif %}
    </template>
</turbo-stream>
{% if sections %}
    <turbo-stream action="replace" target="avail-later-summary">
        <template>
            {% include 'availability/_grid_later_summary.html.twig' with {summary: sections.later, later: grid.dates|filter(item => item.later)} %}
        </template>
    </turbo-stream>
{% endif %}

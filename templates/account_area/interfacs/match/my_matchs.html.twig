{% extends 'layout/account_area.html.twig' %}

{% block content %}

    <style>
        .confirmed {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 10px;
            border-radius: 999px;
            font-size: 14px;
            font-weight: 600;
            background-color: var(--color-green-100);
            color: var(--color-green-800);
            svg {
                width: 16px;
                height: 16px;
            }
        }
        .to-confirm {
            margin-bottom: 25px;
            padding: 12px 16px;
            border-radius: 6px;
            background-color: var(--color-yellow-50);
            border: 1px solid var(--color-yellow-200);
            color: var(--color-yellow-900);
        }
    </style>

    <div data-controller="modal modal-confirm">

        {% if player is null %}
            <p>Ton compte n'est lié à aucun joueur.</p>
        {% elseif upcoming is empty and unscheduled is empty and played is empty %}
            <p>
                Tu n'as pas encore de matchs.
                En attendant, tu peux indiquer <a href="{{ path('my_availabilities') }}">tes disponibilités</a>.
            </p>
        {% else %}
            {% include 'account_area/interfacs/match/_to_confirm.html.twig' %}

            {% include 'interfacs/match/_list.html.twig' with {confirmable: true} %}
        {% endif %}

        {% include 'component/modal/_modal.html.twig' %}
        {% include 'component/modal/_icons_templates.html.twig' %}

    </div>

{% endblock %}

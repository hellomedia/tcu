{% embed 'component/modal/success.html.twig' %}
	{% block streams %}
		<turbo-stream action="replace" target="match-{{ match.id }}-confirmation-status">
			<template>
				{% include 'account_area/interfacs/match/_confirmation_status.html.twig' %}
			</template>
		</turbo-stream>
		{# dashboard : the "À faire" nudge #}
		<turbo-stream action="replace" target="todo-confirm">
			<template>
				{% include 'account_area/dashboard/_todo_confirm.html.twig' %}
			</template>
		</turbo-stream>
		{# Mes matchs : the banner #}
		<turbo-stream action="replace" target="matchs-to-confirm">
			<template>
				{% include 'account_area/interfacs/match/_to_confirm.html.twig' %}
			</template>
		</turbo-stream>
	{% endblock %}
{% endembed %}

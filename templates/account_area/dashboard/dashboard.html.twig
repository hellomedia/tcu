{% extends 'layout/account_area.html.twig' %}

{% block content %}

	<style>
		.homepage-grid {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
			gap: 30px;
		}
		.item {
			background-color: var(--color-primary-background);
            border: 1px solid var(--color-border);
			/* recommended way to center text inside a grid item, using grid as well */
			display: grid; /* could also be done with flexbox, justify-content, align-items, and text-align instead */
			place-content: center; /* title and status line stacked in the middle */
			gap: 6px;
			text-align: center; /* aligns text horizontally in case of full line or multiple lines */
			min-height: 100px;
			padding: 10px;
			border-radius: 3px;
			font-size: 20px;
		}
		.item-status {
			font-size: 14px;
			color: var(--color-gray-500);
		}
		.item-badge {
			display: inline-block;
			margin-left: 4px;
			padding: 1px 8px;
			border-radius: 999px;
			font-size: 13px;
			font-weight: 600;
			background-color: var(--color-yellow-100);
			color: var(--color-yellow-900);

			&.urgent {
				background-color: var(--color-red-100);
				color: var(--color-red-800);
			}
		}
	</style>

	<div class="homepage-grid">
		<a class="item" href="{{ path('my_matchs') }}">
			Mes matchs
			<span class="item-status">
				{% if next_match %}
					Prochain : {{ next_match.date }} · {{ next_match.timeRange }}
				{% else %}
					Aucun match programmé
				{% endif %}
				{% if to_confirm > 0 %}
					<span class="item-badge">{{ to_confirm }} à confirmer</span>
				{% endif %}
			</span>
		</a>
		<a class="item" href="{{ path('my_group') }}">
			Ma poule
			{% if groups is not empty %}
				<span class="item-status">{{ groups|join(', ') }}</span>
			{% endif %}
		</a>
		<a class="item" href="{{ path('my_availabilities') }}">
			Mes disponibilités
			{% if availabilities and availabilities.total > 0 %}
				<span class="item-status">
					{% if availabilities.status == 'complete' %}
						Toutes les dates sont renseignées
					{% else %}
						{% set missing = availabilities.total - availabilities.answered %}
						{{ availabilities.answered }} date{{ availabilities.answered > 1 ? 's' }} sur {{ availabilities.total }} renseignée{{ availabilities.answered > 1 ? 's' }}
						{# red when some of them are less than AvailabilityGrid::SOON away #}
						<span class="item-badge {{ availabilities.missingSoon > 0 ? 'urgent' }}">{{ missing }} à renseigner</span>
					{% endif %}
				</span>
			{% endif %}
		</a>
	</div>
{% endblock %}

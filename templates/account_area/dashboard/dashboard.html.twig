{% extends 'layout/account_area.html.twig' %}

{% block content %}

	{% include 'interfacs/match/_card_styles.html.twig' %}
	{% include 'account_area/interfacs/practice/_card_styles.html.twig' %}

	<style>
		.dash {
			display: grid;
			gap: 36px;
		}
		.dash-hello {
			margin-bottom: -12px;
			font-size: 18px;
			color: var(--color-gray-600);
		}
		.dash-title {
			margin-top: 0; /* sections are spaced by the grid gap */
			margin-bottom: 12px;
			font-size: 18px;
			font-weight: bold;
			color: var(--color-gray-900);
		}

		/* À faire : one row per action ; nothing left to do : the section goes */
		.dash-todo-section:not(:has(.dash-todo)) {
			display: none;
		}
		.dash-todos {
			display: grid;
			gap: 10px;
		}
		.dash-todo {
			display: flex;
			align-items: center;
			gap: 14px;
			padding: 12px 16px;
			border: 1px solid var(--color-yellow-200);
			border-left: 5px solid var(--color-yellow-400);
			border-radius: 6px;
			background-color: var(--color-yellow-50);
			color: var(--color-gray-800);
			&:hover {
				border-color: var(--color-yellow-400);
			}
			svg {
				flex: 0 0 auto;
				width: 22px;
				height: 22px;
				color: var(--color-gray-600);
			}
			.dash-todo-text {
				flex: 1;
			}
			.dash-todo-detail {
				display: block;
				font-size: 14px;
				color: var(--color-gray-600);
			}
			.dash-todo-cta {
				font-weight: 600;
				white-space: nowrap;
			}
		}

		.dash-empty {
			color: var(--color-gray-500);
		}
		.dash-intro {
			margin: -6px 0 12px;
			font-size: 14px;
			color: var(--color-gray-500);
		}

		/* agenda : one block per day, cards below the day */
		.dash-agenda {
			display: grid;
			gap: 22px;
		}
		.dash-day-title {
			margin: 0 0 8px;
			font-size: 15px;
			font-weight: 600;
			color: var(--color-gray-600);
		}
		.dash-day-items {
			display: grid;
			gap: 10px;
		}
		/* the day heading already says the date : the cards only keep the time and the court */
		.dash-day-items .match-card-date,
		.dash-day-items .practice-card-date {
			display: none;
		}
		/* confirmed chip of the match card (see my_matchs) */
		.confirmed {
			display: inline-flex;
			align-items: center;
			gap: 5px;
			padding: 4px 10px;
			border-radius: 999px;
			font-size: 14px;
			font-weight: 600;
			background-color: var(--color-green-100);
			color: var(--color-green-800);
			svg {
				width: 16px;
				height: 16px;
			}
		}

		/* links to the pages */
		.dash-links {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
			gap: 14px;
		}
		.dash-link {
			display: flex;
			align-items: center;
			gap: 14px;
			padding: 16px 18px;
			border: 1px solid var(--color-gray-200);
			border-radius: 8px;
			background-color: #fff;
			color: var(--color-gray-800);
			transition: border-color 0.15s, box-shadow 0.15s;
			&:hover {
				border-color: var(--color-gray-300);
				box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
			}
			.dash-link-icon {
				display: grid;
				place-items: center;
				flex: 0 0 auto;
				width: 44px;
				height: 44px;
				border-radius: 50%;
				background-color: var(--color-gray-100);
				color: var(--color-gray-700);
				svg {
					width: 22px;
					height: 22px;
				}
			}
			.dash-link-text {
				flex: 1;
				min-width: 0;
			}
			.dash-link-title {
				display: block;
				font-size: 17px;
				font-weight: 600;
				color: var(--color-gray-900);
			}
			.dash-link-status {
				display: block;
				font-size: 14px;
				color: var(--color-gray-500);
			}
			.dash-link-chevron {
				width: 14px;
				height: 14px;
				color: var(--color-gray-400);
			}
		}
	</style>

	{# shown once a date within 2 months is missing (AvailabilityGrid::SOON), then counts every date before "Plus tard" (AvailabilityGrid::LATER) #}
	{% set missing_dates = availabilities and availabilities.missingSoon > 0 ? availabilities.missingNear : 0 %}

	<div class="dash" data-controller="modal modal-confirm">

		{% if player %}
			<p class="dash-hello">Salut {{ player.firstname }} 👋</p>
		{% endif %}

		{# hidden by CSS once every nudge is gone (the match nudge is refreshed in place after a confirmation) #}
		{% if player %}
			<section class="dash-todo-section">
				<h2 class="dash-title">À faire</h2>
				<div class="dash-todos">
					{% include 'account_area/dashboard/_todo_confirm.html.twig' %}
					{% if practices_to_answer > 0 %}
						<a class="dash-todo" href="#a-venir">
							<twig:ux:icon name="lessons" />
							<span class="dash-todo-text">
								{{ practices_to_answer > 1 ? practices_to_answer ~ ' entraînements attendent' : '1 entraînement attend' }} ta réponse
								<span class="dash-todo-detail">Dis-nous si tu viens, pour que les autres sachent qui sera là</span>
							</span>
							<span class="dash-todo-cta">Répondre ›</span>
						</a>
					{% endif %}
					{% if missing_dates > 0 %}
						{# partialNear: dates already answered, with slots added since (AvailabilityGrid::build news) #}
						{% set new_slot_dates = availabilities.partialNear %}
						{% set unanswered_dates = missing_dates - new_slot_dates %}
						<a class="dash-todo" href="{{ path('my_availabilities') }}">
							<twig:ux:icon name="calendar" />
							<span class="dash-todo-text">
								{% if new_slot_dates > 0 and unanswered_dates == 0 %}
									Nouveaux créneaux dans mes disponibilités
								{% else %}
									{{ availabilities.answered > 0 or new_slot_dates > 0 ? 'Compléter' : 'Renseigner' }} mes disponibilités
								{% endif %}
								<span class="dash-todo-detail">
									{% if new_slot_dates > 0 %}
										{{- unanswered_dates > 0 ? unanswered_dates ~ ' date' ~ (unanswered_dates > 1 ? 's') ~ ' sans réponse, ' -}}
										{{ new_slot_dates }} date{{ new_slot_dates > 1 ? 's' }} avec un nouveau créneau à renseigner
									{% else %}
										{{ missing_dates }} date{{ missing_dates > 1 ? 's' }} sans réponse{% if availabilities.missingSoon < missing_dates %}, dont {{ availabilities.missingSoon }} dans les deux prochains mois{% endif %}
									{% endif %}
								</span>
							</span>
							<span class="dash-todo-cta">Renseigner ›</span>
						</a>
					{% endif %}
				</div>
			</section>
		{% endif %}

		{% if player %}
			{# agenda : matchs et entraînements à venir, ensemble, par jour #}
			<section id="a-venir">
				<h2 class="dash-title">À venir</h2>
				{% if agenda is empty %}
					<p class="dash-empty">Aucun match programmé pour l'instant.</p>
					{% if first_match_pending and availabilities and availabilities.missingPlanning > 0 %}
						<p class="dash-empty">
							Pour qu'on puisse planifier tes matchs, <a href="{{ path('my_availabilities') }}">renseigne tes disponibilités</a>, au moins pour les quatre prochaines semaines.
						</p>
					{% endif %}
				{% else %}
					<div class="dash-agenda">
						{% for day in agenda %}
							<div class="dash-day">
								<h3 class="dash-day-title">{{ day.label }}</h3>
								<div class="dash-day-items">
									{% for item in day.items %}
										{% if item.type == 'match' %}
											{% include 'interfacs/match/_card.html.twig' with {match: item.match, player: player, confirmable: true} %}
										{% else %}
											{% include 'account_area/interfacs/practice/_card.html.twig' with {practice: item.practice, player: player, answerable: true} %}
										{% endif %}
									{% endfor %}
								</div>
							</div>
						{% endfor %}
					</div>
				{% endif %}
			</section>
		{% endif %}

		{% include 'component/modal/_modal.html.twig' %}
		{% include 'component/modal/_icons_templates.html.twig' %}

		<nav class="dash-links" aria-label="Mon espace">
			<a class="dash-link" href="{{ path('my_matchs') }}">
				<span class="dash-link-icon"><twig:ux:icon name="lessons" /></span>
				<span class="dash-link-text">
					<span class="dash-link-title">Mes matchs</span>
					<span class="dash-link-status">
						{{ upcoming > 0 ? upcoming ~ ' à venir' : 'Aucun match à venir' }}
					</span>
				</span>
				<twig:ux:icon name="forward" class="dash-link-chevron" />
			</a>
			<a class="dash-link" href="{{ path('my_group') }}">
				<span class="dash-link-icon"><twig:ux:icon name="interclubs" /></span>
				<span class="dash-link-text">
					<span class="dash-link-title">Ma poule</span>
					{% for item in groups %}
						<span class="dash-link-status">
							{{ item.group }} · {{ item.position }}{{ item.position == 1 ? 'er' : 'e' }} sur {{ item.players }} · {{ item.points }} pt{{ item.points > 1 ? 's' }}
						</span>
					{% endfor %}
				</span>
				<twig:ux:icon name="forward" class="dash-link-chevron" />
			</a>
			<a class="dash-link" href="{{ path('my_availabilities') }}">
				<span class="dash-link-icon"><twig:ux:icon name="calendar" /></span>
				<span class="dash-link-text">
					<span class="dash-link-title">Mes disponibilités</span>
					{% if availabilities and availabilities.total > 0 %}
						<span class="dash-link-status">
							{% set done = availabilities.answered + availabilities.partial %}
							{{ availabilities.status == 'complete' ? 'Toutes les dates sont renseignées' : done ~ ' date' ~ (done > 1 ? 's') ~ ' sur ' ~ availabilities.total ~ ' renseignée' ~ (done > 1 ? 's') ~ (availabilities.partial > 0 ? ', dont ' ~ availabilities.partial ~ ' avec un nouveau créneau') }}
						</span>
					{% endif %}
				</span>
				<twig:ux:icon name="forward" class="dash-link-chevron" />
			</a>
		</nav>

	</div>
{% endblock %}

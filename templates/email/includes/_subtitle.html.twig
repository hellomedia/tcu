{# section heading inside an email #}
<table class="paragraph_block" width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" style="mso-table-lspace: 0pt; mso-table-rspace: 0pt; word-break: break-word;">
	<tr>
		<td class="pad" style="padding-bottom:4px;padding-left:40px;padding-right:40px;padding-top:22px;">
			<div style="color:#2b303a;font-family:'Raleway', 'Trebuchet MS', Helvetica, sans-serif;font-size:17px;line-height:1.4;text-align:center;">
				<p style="margin: 0; word-break: break-word;"><strong>{{ text }}</strong></p>
			</div>
		</td>
	</tr>
</table>

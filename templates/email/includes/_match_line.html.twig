{# one match : current slot (or former slot when cancelled), opponent, former slot when changed #}
{# vars: item (ConfirmationMailer::describe), kind: 'new'|'changed'|'cancelled'|'unconfirmed' #}
<table class="paragraph_block" width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" style="mso-table-lspace: 0pt; mso-table-rspace: 0pt; word-break: break-word;">
	<tr>
		<td class="pad" style="padding-bottom:8px;padding-left:40px;padding-right:40px;padding-top:8px;">
			<div style="color:#555555;font-family:'Raleway', 'Trebuchet MS', Helvetica, sans-serif;font-size:17px;line-height:1.5;text-align:center;">
				{% if kind == 'cancelled' %}
					<p style="margin: 0; word-break: break-word; color: #808389;">
						<span style="text-decoration: line-through;">{{ item.previous }}</span>
					</p>
				{% else %}
					<p style="margin: 0; word-break: break-word; color: #2b303a;">
						<strong>{{ item.date }}</strong>
						<span style="margin-left: 10px;">{{ item.time }}</span>
						<span style="margin-left: 10px; color: #808389;">{{ item.court }}</span>
					</p>
					{% if kind == 'changed' and item.previous %}
						<p style="margin: 2px 0 0; word-break: break-word; font-size: 14px; color: #808389;">
							au lieu de <span style="text-decoration: line-through;">{{ item.previous }}</span>
						</p>
					{% endif %}
				{% endif %}
				<p style="margin: 2px 0 0; word-break: break-word; font-size: 14px; color: #808389;">
					contre {{ item.opponent }}
				</p>
			</div>
		</td>
	</tr>
</table>

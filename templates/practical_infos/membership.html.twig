{% extends 'layout/default.html.twig' %}

{% block title %}
{% endblock %}

{% block body_extra_classes 'with-cards' %}

{% block content %}

    <style>
        .info {
            margin-bottom: 50px;
        }
        .homepage-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }
        .item {
            background-color: white;
            /* recommended way to center text inside a grid item, using grid as well */
            display: grid; /* could also be done with flexbox, justify-content, align-items, and text-align instead */
            place-items: center; /* for a grid containing plain text, this combines align and justify */
            text-align: center; /* aligns text horizontally in case of full line or multiple lines */
            height: 100px;
            padding: 10px;
            border-radius: 3px;
            font-size: 20px;
        }
    </style>

    <div class="info">

        <p>
            Devenir membre vous donne accès aux terrains extérieurs
            de mars à novembre.
        <p>

        <h3>Cotisation annuelle</h3>
        <table class="table">
            <tr>
                <th>Cotisation</th>
                <th>Tarif</th>
            </tr>
            <tr>
                <td>Adultes</td>
                <td>95 €</td>
            </tr>
            <tr>
                <td>Etudiants enseignements supérieur (Université + Hautes écoles)</td>
                <td>85 €</td>
            </tr>
            <tr>
                <td>Adolescents - enseignement secondaire</td>
                <td>85 €</td>
            </tr>
            <tr>
                <td>Enfants - enseignement primaire</td>
                <td>50 €</td>
            </tr>
        </table>

        <h3>Procédure</h3>
        <p>
            1. Remplir <a target="_blank" href="https://forms.gle/6A4XYexig2Yu4Pqn7">le Google form</a>
        </p>
        </p>
            2. Payer la cotisation dans l'application MonClub :
            Choisir la formule « Tennis - TC Université » puis payer.
        </p>
        <p>
            La procédure en détail
            <a href="{{ asset('pdf/infos_tcu_2026.pdf') }}">est expliquée ici</a>.
        </p>


    </div>

{% endblock %}

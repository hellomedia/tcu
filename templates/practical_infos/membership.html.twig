{% extends 'layout/default.html.twig' %}

{% block title %}
{% endblock %}

{% block body_extra_classes 'with-cards' %}

{% block content %}

    <style>
        .info {
            margin-bottom: 50px;
        }
        .homepage-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }
        .item {
            background-color: white;
            /* recommended way to center text inside a grid item, using grid as well */
            display: grid; /* could also be done with flexbox, justify-content, align-items, and text-align instead */
            place-items: center; /* for a grid containing plain text, this combines align and justify */
            text-align: center; /* aligns text horizontally in case of full line or multiple lines */
            height: 100px;
            padding: 10px;
            border-radius: 3px;
            font-size: 20px;
        }
    </style>

    <div class="info">

        <p>
            Les membres ont accès aux terrains extérieurs
            de mars à novembre.
        <p>

        <h3>Cotisation annuelle</h3>
        <p>
            L'inscription à
            <a href="https://www.sports.uliege.be/cms/c_11118724/fr/uliege-sports">ULiege sports</a>
            est obligatoire pour l'inscription au TCU.
        <p>
        <table class="table" style="margin-top: 30px">
            <tr>
                <th>Statut</th>
                <th>ULiege sports</th>
                <th>TCU</th>
            </tr>
            <tr>
                <td>Etudiants ULiège</td>
                <td>40 €</td>
                <td>85 €</td>
            </tr>
            <tr>
                <td>Etudiants supérieur hors ULiège</td>
                <td>45 €</td>
                <td>85 €</td>
            </tr>
            <tr>
                <td>Adolescents - secondaire</td>
                <td>45 €</td>
                <td>85 €</td>
            </tr>
            <tr>
                <td>Enfants - primaire</td>
                <td>45 €</td>
                <td>50 €</td>
            </tr>
            <tr>
                <td>Ancien étudiant ULiege</td>
                <td>60 €</td>
                <td>95 €</td>
            </tr>
            <tr>
                <td>Autres</td>
                <td>65 €</td>
                <td>95 €</td>
            </tr>
        </table>
        <p style="margin-top: 30px">
            NB: La plupart des mutuelles remboursent une partie de la cotisation à un club sportif.
            Les chèques sports sont également acceptés.
        </p>

        <h3>Procédure</h3>
        <p>
            1. Remplir <a target="_blank" href="https://forms.gle/6A4XYexig2Yu4Pqn7">le Google form</a>
        </p>
        </p>
            2. Payer la cotisation dans l'application MonClub :
            Choisir la formule « Tennis - TC Université » puis payer.
        </p>
        <p>
            La procédure en détail
            <a href="{{ asset('pdf/infos_tcu_2026.pdf') }}">est expliquée ici</a>.
        </p>


    </div>

{% endblock %}

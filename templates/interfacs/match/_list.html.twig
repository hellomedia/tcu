{#
    Matchs of one player, by section: upcoming, not yet scheduled, played.
    vars:
      - player
      - upcoming, unscheduled, played: lists of matchs (played: most recent first)
      - confirmable: show the schedule confirmation on upcoming matchs (account area)
#}
<style>
    .match-sections {
        display: grid;
        gap: 40px;
    }
    .match-section-title {
        display: flex;
        align-items: baseline;
        gap: 10px;
        margin-top: 0; /* sections are spaced by the grid gap */
        margin-bottom: 15px;
        font-size: 18px;
        font-weight: bold;

        .count {
            font-size: 14px;
            font-weight: normal;
            color: var(--color-gray-500);
        }
    }
    .match-section-intro {
        margin-top: -8px;
        margin-bottom: 15px;
        color: var(--color-gray-500);
        font-size: 14px;
    }
    .match-cards {
        display: grid;
        gap: 12px;

        @media (min-width: 1000px) {
            grid-template-columns: 1fr 1fr;
        }
    }

    .match-empty {
        padding: 20px;
        border: 1px dashed var(--color-gray-300);
        border-radius: 6px;
        color: var(--color-gray-500);
    }
</style>

{% include 'interfacs/match/_card_styles.html.twig' %}

<div class="match-sections">

    <section>
        <h2 class="match-section-title">
            À venir
            {% if upcoming is not empty %}<span class="count">{{ upcoming|length }}</span>{% endif %}
        </h2>
        {% if upcoming is not empty %}
            <div class="match-cards">
                {% for match in upcoming %}
                    {% include 'interfacs/match/_card.html.twig' %}
                {% endfor %}
            </div>
        {% else %}
            <p class="match-empty">
                Aucun match programmé pour le moment.
                {% if unscheduled is not empty %}Les dates sont fixées en fonction des disponibilités.{% endif %}
            </p>
        {% endif %}
    </section>

    {% if unscheduled is not empty %}
        <section>
            <h2 class="match-section-title">
                Pas encore programmés
                <span class="count">{{ unscheduled|length }}</span>
            </h2>
            <div class="match-cards">
                {% for match in unscheduled %}
                    {% include 'interfacs/match/_card.html.twig' %}
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {% if played is not empty %}
        <section>
            <h2 class="match-section-title">
                Joués
                <span class="count">{{ played|length }}</span>
            </h2>
            <div class="match-cards">
                {% for match in played %}
                    {% include 'interfacs/match/_card.html.twig' %}
                {% endfor %}
            </div>
        </section>
    {% endif %}

</div>

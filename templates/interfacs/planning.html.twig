{% extends 'layout/interfacs.html.twig' %}

{% block body_extra_classes 'with-cards' %}

{% block content %}

    <style>
        .date {
            background-color: #fff;
            border: 0px solid #ddd;
            border-radius: 3px;
            padding: 30px;
            h4 {
                margin-top: 10px;
                margin-bottom: 5px;
                font-weight: bold;
            }
        }
        .placeholder {
            visibility: hidden;
            width: 15px;
        }
        .date-header {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 10px;
        }
        .courts {
            h5 {
                text-align: center;
                white-space: nowrap;
            }
        }
        .slots {
            margin-top: 15px;
            display: flex;
            flex-direction: column;
            gap: 3px;
        }
        .slot-row {
            height: 60px;
        }
        .slot-content {
            border: 1px dashed #ccc;
        }
        /* POULE COLOUR : stripe on the left of a booked slot, as in the admin planning */
        .slot-row.booked .slot-content {
            border: 1px solid color-mix(in srgb, var(--group-color) 35%, #fff);
            border-left: 5px solid var(--group-color);
            background-color: color-mix(in srgb, var(--group-color) 8%, #fff);
        }

        /* POULE LEGEND : click a poule to see only its matchs (planning_filter_controller) */
        .group-legend {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px;
            margin-bottom: 20px;
            font-size: 14px;
        }
        .group-legend-item {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 12px 4px 10px;
            border: 1px solid var(--color-gray-200);
            border-radius: 999px;
            background: #fff;
            color: var(--color-gray-700);
            font-weight: 500;
            cursor: pointer;
            &:hover {
                border-color: var(--group-color);
            }
            &.active {
                border-color: var(--group-color);
                box-shadow: inset 0 0 0 1px var(--group-color);
                color: var(--color-gray-900);
            }
            .swatch {
                width: 12px;
                height: 12px;
                border-radius: 3px;
                background: var(--group-color);
            }
        }
        .group-legend-reset {
            all: unset;
            color: var(--color-gray-500);
            cursor: pointer;
            text-decoration: underline;
            &[hidden] {
                display: none;
            }
        }
        /* other slots fade but keep their place (times aligned across courts), dates without the poule are hidden */
        .slot-row.dimmed {
            opacity: 0.18;
            transition: opacity 0.15s;
        }
        .date.all-dimmed {
            display: none;
        }
        .slot-content-inner,
        .slot-actions-inner {
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        /* LAYOUT */
        .planning {
            display: grid;
            gap: 30px;
            grid-template-columns: 1fr;
        }
        .date {
            overflow-x: auto; /* add scrollbar when necessary */
        }
        .courts {
            display: flex;
            flex-wrap: wrap;
        }
        .court {
            width: 100%;
            margin-bottom: 30px;
        }
        .slot-row, .court-header {
            display: grid;
            grid-template-columns: 50px minmax(190px, 1fr);
            gap: 5px;
        }
        @media (min-width: 768px) {
            .planning {
                grid-template-columns: 1fr;
                &.court-count-1 {
                    grid-template-columns: repeat(2, 1fr);
                }
            }
            .courts {
                flex-wrap: nowrap;
                gap: 15px;
            }
            .court {
                width: 100%; /* makes all items the same size no matter the content */
                margin-bottom: 0;
            }
            .slot-row, .court-header {
                grid-template-columns: 50px minmax(190px, 1fr);
                .btn {
                    visibility: hidden;
                }
                &:hover {
                    .btn {
                        visibility: visible;
                    }
                }
            }
        }
        @media (min-width: 1400px) {
            .planning {
                &.court-count-2 {
                    grid-template-columns: repeat(2, 1fr);
                }
            }
        }
    </style>

    {% set me = app.user ? app.user.player : null %}
    {% set my_slots = me ? dates|reduce((count, date) => count + date.slots|filter(slot => slot.match and slot.match.sideOf(me))|length, 0) : 0 %}

    {# filters are not remembered: the planning always opens with every poule #}
    <div data-controller="planning-filter">

    {% if groups is not empty %}
        <div class="group-legend" aria-label="Poules">
            {% if my_slots > 0 %}
                <button type="button"
                    class="group-legend-item group-legend-mine"
                    style="--group-color: var(--color-yellow-400)"
                    data-group-id="mine"
                    data-planning-filter-target="group"
                    data-action="planning-filter#toggleGroup"
                    title="Ne voir que mes matchs"
                ><span class="swatch"></span>Mes matchs</button>
            {% endif %}
            {% for group in groups %}
                <button type="button"
                    class="group-legend-item"
                    style="--group-color: {{ group_color(group) }}"
                    data-group-id="{{ group.id }}"
                    data-planning-filter-target="group"
                    data-action="planning-filter#toggleGroup"
                    title="Ne voir que les matchs de cette poule"
                ><span class="swatch"></span>{{ group }}</button>
            {% endfor %}
            <button type="button" class="group-legend-reset" data-planning-filter-target="reset" data-action="planning-filter#reset" hidden>Toutes les poules</button>
        </div>
    {% endif %}

    <div class="planning" data-planning-filter-target="planning">

        {% for date in dates %}
            <div class="date">
                <div class="date-header">
                    <h4>{{ date }}</h4>
                </div>
                <div class="courts">
                    {# only the courts with slots this date #}
                    {% for court in courts|filter(court => date.slotsByCourt(court) is not empty) %}
                        {% set slots = date.slotsByCourt(court) %}
                        <div class="court">
                            <div class="court-header">
                                <div class="court-header-placeholder"></div>
                                <h5>{{ court }}</h5>
                            </div>
                            <div class="slots">
                                {% for slot in slots %}
                                    {% set group = slot.match ? slot.match.group : null %}
                                    <div class="slot-row {{ group ? 'booked' }} {{ me and group and slot.match.sideOf(me) ? 'mine' }}" {% if group %}data-group-id="{{ group.id }}" style="--group-color: {{ group_color(group) }}" title="{{ group }}"{% endif %}>
                                        <div class="slot-time">
                                            {{ slot.startsAt|date('H:i') }}
                                        </div>
                                        <div class="slot-content">
                                            <div class="slot-content-inner">
                                                {# <div class="placeholder"></div> #}
                                                {% for player in slot.players %}
                                                    <span class="player">{{ player }}</span>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endfor %}

    </div>

    </div>

{% endblock %}
{% extends 'layout/default.html.twig' %}

{% block body_extra_classes 'with-cards' %}

{% block content %}

    <style>
        .matchs {
            display: block; /* turbo-frame is inline by default */
            margin-top: 40px;
        }
        .matchs-title {
            margin-bottom: 25px;
        }
    </style>

	{# The form targets the frame so only the list is swapped #}
	{{ form_start(form, {
        attr: {
            'data-controller': 'autosubmit',
            'data-action': 'change->autosubmit#submit',
            'data-turbo-frame': 'player-matchs'
        }
    }) }}

    {{ form_row(form.player) }}
	{{ form_end(form) }}

	<turbo-frame id="player-matchs" class="matchs">

        {% if player %}

            {% if upcoming is empty and unscheduled is empty and played is empty %}
                <h2 class="matchs-title">{{ player.firstname }}, tu n'as pas encore de matchs cette saison.</h2>
            {% else %}
                <h2 class="matchs-title">{{ player.firstname }}, voilà tes matchs ✨</h2>

                {% include 'interfacs/match/_list.html.twig' %}
            {% endif %}

		{% endif %}

	</turbo-frame>

{% endblock %}

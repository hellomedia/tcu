{# styles of interfacs/group/_card, included once per page #}
<style>
    .groups {
        display: grid;
        gap: 30px;
        /* edge-to-edge */
        margin-inline: calc(var(--spacing) * (-6)); /* inverse of default-container-x-padding */
        .group {
            border-radius: 0;
            padding: 30px 25px;
        }
        .long {
            display: none;
        }
        @media (min-width: 600px) {
            /* end of edge-to-edge */
            margin-inline: 0;
            .group {
                border-radius: 6px;
                padding: 30px;
            }
            .short {
                display: none;
            }
            .long {
                display: inline;
            }
        }
        @media (min-width: 1000px) {
            grid-template-columns: 1fr 1fr;
        }
    }

    .group {
        background-color: #fff;
        /* poule colour as a line on top of the card */
        border-top: 4px solid var(--group-color, transparent);
    }
    .group-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 10px;
        margin-bottom: 20px;

        h4 {
            font-weight: bold;
            margin-right: auto; /* "Ta poule" and the planning link on the right */
        }
        .group-mine {
            font-size: 13px;
            color: var(--color-gray-500);
        }
        /* leads to Ma poule in the account area: account icon, as the "Mes interfacs" tab of the interfacs band */
        .group-mine-link {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            color: var(--color-theme-darker);
            font-weight: 600;
            white-space: nowrap;
            svg {
                width: 15px;
                height: 15px;
            }
        }
        .group-planning-link {
            font-size: 13px;
            white-space: nowrap;
            text-decoration: underline;
        }
    }
    /* matchs folded under a toggle (public poules page) */
    .group-matchs {
        margin-top: 20px;
        summary {
            cursor: pointer;
            font-weight: 600;
            color: var(--color-gray-700);
        }
        .dates {
            margin-top: 10px;
        }
    }
    .players {
        width: 100%;
        margin-bottom: 10px;
        .rank {
            width: 18px;
            padding-right: 0;
            color: var(--color-gray-500);
        }
        th,
        .ranking,
        .points,
        .matchs-played {
            text-align: center;
        }
        .ranking {
            white-space: nowrap;
            color: var(--color-gray-500);
        }
        .points {
            font-weight: bold;
            color: var(--color-gray-900);
        }
        tr.me td {
            background-color: var(--color-yellow-50);
        }
        tr.me .player {
            font-weight: 600;
            color: var(--color-gray-900);
        }
    }
    .dates {
        display: grid;
        grid-template-columns: 1fr auto; /* sides | time or score */
        margin-top: 30px;
    }
    .date {
        margin-top: 20px;
        grid-column: span 2;
        font-weight: bold;
    }

    .matchs {
        /* prentend div does not exist for grid and exposes children to the grid ! */
        /* allows to keep div for semantic markup without getting in the way of the grid ! */
        display: contents;
    }

    .match {
        /* prentend div does not exist for grid and exposes children to the grid ! */
        /* allows to keep div for semantic markup without getting in the way of the grid ! */
        display: contents;
    }

    .side {
        display: block;
        @media (min-width: 600px) {
            display: inline;
        }
        &.winner {
            font-weight: 600;
            color: var(--color-gray-900);
        }
    }

    .nowrap {
        white-space: nowrap;
    }

    .sides {
        /* first column */
        display: flex;
        flex-direction: column;
        border-left: 1px solid #f1f3f5;
    }

    .sides,
    .score,
    .time {
        padding: 10px 16px;
        background: #f9fafb;
        border-top: 1px solid #f1f3f5;
        border-bottom: 1px solid #f1f3f5;
        margin-top: 15px;
        margin-bottom: 15px;
    }

    /* the player's own matchs */
    .match.mine {
        .sides {
            border-left: 3px solid var(--color-yellow-400);
        }
        .sides,
        .score,
        .time {
            background: var(--color-yellow-50);
        }
    }

    .score, .time {
        border-right: 1px solid #f1f3f5;
    }

    .score {
        /* second column */
        display: flex;
        flex-direction: row;
        align-items: center;
        font-variant-numeric: tabular-nums;
        color: var(--color-gray-500);
        td {
            padding-inline: 4px;
        }
        td:first-child {
            padding-left: 0;
        }
        td:last-child {
            padding-right: 0;
        }
        .won {
            font-weight: bold;
            color: var(--color-gray-900);
        }
    }
    .time {
        /* second column */
        text-align: right;
        display: flex;
        flex-direction: row;
        align-items: center;
    }
</style>

<nav
	id="main-menu"
	data-controller="menu-hover"
>

	<div class="full-w-container full-w-container-xpadding">
		<div id="main-menu-bar">
			<div class="main-menu-start">
				<div class="logo">
					<a href="{{ path('homepage') }}"
                        class="logo-link"
                        style="color: white;"
                    >
						TC Université
					</a>
					{# small screens: the section next to the site name (the top menu items are hidden, the band only has tabs) #}
					{% set section = current_section() %}
					{% if section %}
						<a href="{{ path(section.route) }}" class="logo-section">
							<span class="logo-section-separator" aria-hidden="true">›</span>
							{{ section.name }}
						</a>
					{% endif %}
				</div>

                <div id="main-menu-items">
					<a href="{{ path('interfacs_planning') }}"
						class="main-menu-item {{ app.current_route starts with 'interfacs' ? 'current' }}"
						data-action="mouseenter->menu-hover#enter mouseleave->menu-hover#leave">
						Interfacs
					</a>
					<a href="{{ path('interclubs') }}"
						class="main-menu-item {{ app.current_route starts with 'interclubs' ? 'current' }}"
						data-action="mouseenter->menu-hover#enter mouseleave->menu-hover#leave">
						Interclubs
					</a>
                    <a href="{{ path('cours') }}"
						class="main-menu-item {{ app.current_route starts with 'cours' ? 'current' }}"
						data-action="mouseenter->menu-hover#enter mouseleave->menu-hover#leave">
						Cours
					</a>
					<a href="{{ path('practical_infos') }}"
						class="main-menu-item {{ app.current_route starts with 'practical_infos' ? 'current' }}"
						data-action="mouseenter->menu-hover#enter mouseleave->menu-hover#leave">
						Infos pratiques
					</a>

                </div>
			</div>

			<div class="main-menu-end">

				{% if is_granted('ROLE_USER') %}
					<div class="main-menu-account">
						{% include "layout/menu/_account_menu.html.twig" %}
					</div>
				{% endif %}

				{% if not is_granted('ROLE_USER') %}
					<div class="main-menu-login">
						<a href="{{ path('login') }}" />{{ 'Login'|trans }}</a>
					</div>
				{% endif %}

				<div
					class="main-menu-mobile"
					data-controller="mobile-menu"
				>
					{% include "layout/menu/_mobile_menu_button.html.twig" with {
						mobile_menu_button_extra_classes: 'main-menu-mobile-button'
					} %}
					{% include "layout/menu/_mobile_menu.html.twig" %}
					{% include 'layout/menu/_bottom_menu.html.twig' %}
				</div>
			</div>
		</div>
	</div>

</nav>

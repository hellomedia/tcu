{# Compte créé par un admin, mot de passe pas encore choisi : ChoosePasswordController #}
{% if app.user and app.user.mustChoosePassword and app.current_route != 'password_choose' %}
    <div class="alert alert-info" style="margin-bottom: 0; text-align: center;">
        Votre compte a été créé par le club : <a href="{{ path('password_choose') }}"><strong>choisissez votre mot de passe</strong></a> pour vous reconnecter facilement.
    </div>
{% endif %}

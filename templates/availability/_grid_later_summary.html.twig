{# Title of the "Plus tard" dates, refreshed after each autosave #}
{# vars: summary (AvailabilityGrid::build sections.later), later (dates of the section) #}
<summary class="avail-later-summary" id="avail-later-summary">
    <span class="avail-later-title">
        Plus tard
        <span class="avail-later-months">
            {{ later|first.date.date|format_date(pattern: 'MMMM', locale: 'fr') }}
            {%- if (later|last.date.date|date('Y-m')) != (later|first.date.date|date('Y-m')) %} – {{ later|last.date.date|format_date(pattern: 'MMMM', locale: 'fr') }}{% endif %}
            · {{ summary.total }} date{{ summary.total > 1 ? 's' }}
        </span>
    </span>
    {# same colours as the summary on top: green done, orange started, grey not started #}
    <span class="avail-badge {{ summary.status }}">
        {% if summary.status == 'complete' %}
            toutes renseignées
        {% elseif summary.status == 'partial' %}
            {% set done = summary.answered + summary.partial %}
            {{ done }} sur {{ summary.total }} renseignée{{ done > 1 ? 's' }}{{ summary.partial > 0 ? ', ' ~ summary.partial ~ ' avec un nouveau créneau' }}
        {% else %}
            pas encore renseignées
        {% endif %}
    </span>
</summary>

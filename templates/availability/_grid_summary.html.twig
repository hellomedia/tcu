{# Summary line of the availability grid, refreshed after each autosave #}
{# vars: summary (AvailabilityGrid::summary) #}
<div class="avail-summary" id="avail-summary">
    <span class="avail-badge {{ summary.status }}">
        {% if summary.total == 0 %}
            Aucune date à venir
        {% elseif summary.status == 'complete' %}
            Toutes les dates sont renseignées
        {% else %}
            {{ summary.answered }} date{{ summary.answered > 1 ? 's' }} sur {{ summary.total }} renseignée{{ summary.answered > 1 ? 's' }}{{ summary.partial > 0 ? ', ' ~ summary.partial ~ ' partielle' ~ (summary.partial > 1 ? 's') }}
        {% endif %}
    </span>
    <span class="avail-legend">
        <span><span class="dot dot-yes"></span>disponible</span>
        <span><span class="dot dot-no"></span>pas disponible</span>
        <span><span class="dot dot-unknown"></span>pas renseigné</span>
    </span>
</div>

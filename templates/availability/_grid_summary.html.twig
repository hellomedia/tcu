{# Summary line of the availability grid, refreshed after each autosave #}
{# vars: summary (AvailabilityGrid::summary or one of its sections), label (optional: which dates it counts) #}
<div class="avail-summary" id="avail-summary">
    <span class="avail-badge {{ summary.status }}">
        {%- if label|default(false) %}{{ label }} : {% endif -%}
        {% if summary.total == 0 %}
            Aucune date à venir
        {% elseif summary.status == 'complete' %}
            {{ label|default(false) ? 'toutes renseignées' : 'Toutes les dates sont renseignées' }}
        {% else %}
            {# a partial date was answered before slots were added: counted as answered, its new slots mentioned apart #}
            {% set done = summary.answered + summary.partial %}
            {{ done }} date{{ done > 1 ? 's' }} sur {{ summary.total }} renseignée{{ done > 1 ? 's' }}{{ summary.partial > 0 ? ', dont ' ~ summary.partial ~ ' avec un nouveau créneau' }}
        {% endif %}
    </span>
    <span class="avail-legend">
        <span><span class="dot dot-yes"></span>disponible</span>
        <span><span class="dot dot-no"></span>pas disponible</span>
        <span><span class="dot dot-unknown"></span>pas renseigné</span>
    </span>
</div>

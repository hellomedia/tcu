# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Test hosts: requests never leave the process, but generated URLs (emails) should not look like prod.
HOST="tcu.test"
HOST_ADMIN="admin.tcu.test"
# Never send emails from tests. .env ends with an empty MAILER_DSN (Postmark placeholder).
MAILER_DSN=null://null

# DATABASE_URL goes in .env.test.local (git-ignored), like .env.local for dev.
# Doctrine appends "_test" to the database name (config/packages/doctrine.yaml).

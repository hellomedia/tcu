{% set practice = slot.practice %}
{% set group = slot.match ? slot.match.group : (practice and practice.groups is not empty ? practice.groups|first : null) %}
<div class="slot-row {{ slot.booking ? 'booked' : 'free' }} {{ practice ? 'practice' }} {{ practice and practice.cancelled ? 'cancelled' }}"
    id="slot-{{ slot.id }}"
    data-slot-id="{{ slot.id }}"
    data-date-id="{{ slot.date.id }}"
    data-starts-at="{{ slot.startsAt|date('H:i') }}"
    data-label="{{ slot }}"
    {% if slot.match %}
        data-match-id="{{ slot.match.id }}"
        data-match-label="{{ slot.match }}"
        data-has-confirmations="{{ slot.match.confirmationInfos is not empty ? 1 : 0 }}"
    {% endif %}
    {% if practice %}
        data-practice-id="{{ practice.id }}"
        {# poule focus (planning_filter_controller): a practice can belong to several poules #}
        data-group-ids="{{ practice.groups|map(g => g.id)|join(' ') }}"
    {% endif %}
    data-controller="slot-menu"
    {% if group %}data-group-id="{{ group.id }}" style="--group-color: {{ group_color(group) }}"{% endif %}
>
	<div class="slot-time">
		{{ slot.startsAt|date('H:i') }}
	</div>
	<div class="slot-content" {% if slot.match and group %}title="{{ group }}" draggable="true"{% elseif practice %}title="Entraînement {{ practice.label }}"{% endif %}
		data-action="click->slot-menu#openFromStrip"
	>
		<div class="slot-content-inner {{ slot.booking ? 'with-match' }}">
			{# <div class="placeholder"></div> #}
            {% if slot.booking is empty %}
				<a class="btn btn-default"
                    href="{{ path('admin_planning_slot_add_booking', {'id': slot.id}) }}"
                    data-action="modal-remote-form#open"
                >
					<twig:ux:icon name="add"/>
					Match
				</a>
				{# phone : no button, a tap on the strip opens the menu (match / entraînement) #}
				<span class="slot-free-hint">Libre</span>
            {% elseif practice %}
                <div class="practice-info">
                    <div class="practice-title">
                        <span class="practice-kind {{ practice.cancelled ? 'cancelled' }}">{{ practice.cancelled ? 'Annulé' : 'Entraînement' }}</span>
                        <span class="practice-label">{{ practice.label }}</span>
                    </div>
                    <div class="practice-details">
                        {% if practice.slots|length > 1 %}
                            <span>{{ practice.timeRange }} · {{ practice.courtsLabel }}</span>
                        {% endif %}
                        {% if practice.players is not empty %}
                            {% set coming = practice.comingPlayers|length %}
                            {% set notComing = practice.notComingPlayers|length %}
                            <span class="practice-answers" title="{{ practice.comingPlayers|join(', ') ?: 'personne n\'a encore dit venir' }}">
                                {{ coming }} ✓ · {{ notComing }} ✕ · {{ practice.players|length - coming - notComing }} ?
                            </span>
                        {% endif %}
                    </div>
                </div>
            {% else %}
                <div class="sides">
                    <div class="side">
                        {% for participant in slot.match.participantsForSide(enum('App\\Enum\\Side').A) %}
                            {{ loop.index == 2 ? ' - ' }}
                            {% include '@admin/planning/_slot_row_participant.html.twig' %}
                        {% endfor %}
                    </div>
                    <div class="side">
                        {% for participant in slot.match.participantsForSide(enum('App\\Enum\\Side').B) %}
                            {{ loop.index == 2 ? ' - ' }}
                             {% include '@admin/planning/_slot_row_participant.html.twig' %}
                        {% endfor %}
                    </div>
                </div>
                <div class="results">
                    {% set result = slot.match.result %}
                    {% if result %}
                        <table>
                            <tr>
                                <td>{{ result.set1A }}</td>
                                {% if result.set2A or result.set2B %}
                                    <td>{{ result.set2A }}</td>
                                {% endif %}
                                {% if result.set3A or result.set3B %}
                                    <td>{{ result.set3A }}</td>
                                {% endif %}
                            </tr>
                            <tr>
                                <td>{{ result.set1B }}</td>
                                {% if result.set2A or result.set2B %}
                                    <td>{{ result.set2B }}</td>
                                {% endif %}
                                {% if result.set3A or result.set3B %}
                                    <td>{{ result.set3B }}</td>
                                {% endif %}
                            </tr>
                        </table>
                    {% endif %}
                </div>
			{% endif %}
		</div>
	</div>
	<div class="slot-actions">
		<div class="slot-actions-inner">
			{% if practice %}
				{% include "@admin/planning/_slot_actions_practice.html.twig" %}
			{% elseif slot.booking is not empty %}
				{% include "@admin/planning/_slot_actions.html.twig" %}
			{% else %}
				{% include "@admin/planning/_slot_actions_free.html.twig" %}
			{% endif %}
		</div>
	</div>
</div>

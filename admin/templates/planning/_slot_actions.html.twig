{# Menu of a booked slot (slot_menu_controller.js): native popover, out of the .date overflow.
   Desktop: anchored to the dots. Phone: bottom sheet opened by a tap on the strip. #}
<div class="planning-slot-actions">
	<button type="button"
		class="btn slot-menu-button"
		data-slot-menu-target="button"
		data-action="pointerdown->slot-menu#rememberState slot-menu#toggle"
		aria-haspopup="menu"
		aria-expanded="false"
		aria-controls="slot-menu-{{ slot.id }}"
		title="Actions"
	>
		<twig:ux:icon name="dots"/>
	</button>

	<div popover
		id="slot-menu-{{ slot.id }}"
		class="slot-menu"
		data-slot-menu-target="menu"
		data-action="beforetoggle->slot-menu#beforeToggle click->slot-menu#closeOnItem"
	>
            {# phone only: the sheet hides the row, recall which match it is #}
            <div class="slot-menu-header">
                <div class="slot-menu-match">{{ slot.match }}</div>
                <div class="slot-menu-slot">{{ slot }}</div>
                {% if slot.match.result %}
                    <div class="slot-menu-score">
                        {% for set in slot.match.result.sets %}{{ set[0] }}/{{ set[1] }} {% endfor %}
                    </div>
                {% endif %}
            </div>

            <div class="hk-dropdown-inner">

                {% if slot.match.result is empty %}
                    <a class="hk-dropdown-link"
                        href="{{ path('admin_match_add_result', {'id': slot.match.id}) }}"
                        data-action="modal-remote-form#open"
                    >
                        <twig:ux:icon name="add"/>
                        Ajouter résultat
                    </a>
                {% else %}
                    <a class="hk-dropdown-link"
                        href="{{ path('admin_match_add_result', {'id': slot.match.id}) }}"
                        data-action="modal-remote-form#open"
                    >
                        <twig:ux:icon name="edit"/>
                        Modifier résultat
                    </a>
                {% endif %}

                <a class="hk-dropdown-link"
                    href="{{ path('admin_match_confirmation_info', {'id': slot.match.id}) }}"
                    data-action="modal-remote-form#open"
                >
                    <twig:ux:icon name="confirm-user"/>
                    Infos de confirmation
                </a>

                <hr>

                <a class="hk-dropdown-link"
                    href="{{ path('admin_match_move_booking', {'id': slot.match.id}) }}"
                    data-action="modal-remote-form#open"
                >
                    <twig:ux:icon name="calendar"/>
                    Déplacer / changer de terrain
                </a>

				<button type="button"
                    class="hk-dropdown-link"
                    formaction="{{ path('admin_planning_slot_remove_booking', {'id': slot.id}) }}"
                    data-action="modal-confirm#open"
                    data-title="Déprogrammer le match"
                    data-html="<p>Le match <b>{{ slot.match }}</b> devra être reprogrammé et le créneau est libéré.<br>Les confirmations des joueurs sont supprimées.</p>"
                    data-button-label="Déprogrammer le match"
                    data-variant="warning"
                    data-csrf="{{ csrf_token('delete-booking') }}"
                >
                    <twig:ux:icon name="delete" />
                    Déprogrammer le match
                </button>

            </div>
	</div>
</div>

{# Menu of a slot booked for a practice (slot_menu_controller.js), see _slot_actions.html.twig for a match #}
{% set practice = slot.practice %}
{% set notified = practice.countNotifiedPlayers %}
<div class="planning-slot-actions">
	<button type="button"
		class="btn slot-menu-button"
		data-slot-menu-target="button"
		data-action="pointerdown->slot-menu#rememberState slot-menu#toggle"
		aria-haspopup="menu"
		aria-expanded="false"
		aria-controls="slot-menu-{{ slot.id }}"
		title="Actions"
	>
		<twig:ux:icon name="dots"/>
	</button>

	<div popover
		id="slot-menu-{{ slot.id }}"
		class="slot-menu"
		data-slot-menu-target="menu"
		data-action="beforetoggle->slot-menu#beforeToggle click->slot-menu#closeOnItem"
	>
            {# phone only: the sheet hides the row, recall which practice it is #}
            <div class="slot-menu-header">
                <div class="slot-menu-match">Entraînement {{ practice.label }}</div>
                <div class="slot-menu-slot">{{ practice.scheduleLabel }}</div>
            </div>

            <div class="hk-dropdown-inner">

                {% if not practice.past %}
                    <a class="hk-dropdown-link"
                        href="{{ path('admin_practice_edit', {'id': practice.id}) }}"
                        data-action="modal-remote-form#open"
                    >
                        <twig:ux:icon name="edit"/>
                        Modifier (créneaux, poules, note)
                    </a>

                    <button type="button"
                        class="hk-dropdown-link"
                        formaction="{{ path('admin_practice_cancel', {'id': practice.id}) }}"
                        data-action="modal-confirm#open"
                        data-title="Annuler l'entraînement"
                        data-html="<p><b>{{ practice.label|e }}</b><br>{{ practice.scheduleLabel }}</p><p>Il reste affiché aux joueurs comme annulé et {{ practice.slots|length > 1 ? 'ses ' ~ practice.slots|length ~ ' créneaux sont libérés' : 'le créneau est libéré' }}. Définitif.</p>"
                        data-button-label="Annuler l'entraînement"
                        data-variant="warning"
                        data-csrf="{{ csrf_token('practice-cancel') }}"
                    >
                        <twig:ux:icon name="cross" />
                        Annuler l'entraînement
                    </button>

                    <hr>
                {% endif %}

				<button type="button"
                    class="hk-dropdown-link"
                    formaction="{{ path('admin_practice_delete', {'id': practice.id}) }}"
                    data-action="modal-confirm#open"
                    data-title="Supprimer l'entraînement"
                    data-html="<p><b>{{ practice.label|e }}</b><br>{{ practice.scheduleLabel }}</p><p>Il disparaît sans trace et {{ practice.slots|length > 1 ? 'ses ' ~ practice.slots|length ~ ' créneaux sont libérés' : 'le créneau est libéré' }}.{% if notified > 0 %}<br><b>{{ notified }} joueur{{ notified > 1 ? 's ont' : ' a' }} déjà été prévenu{{ notified > 1 ? 's' }} par email</b> : préférer l'annulation, qui leur sera communiquée.{% endif %}</p>"
                    data-button-label="Supprimer"
                    data-variant="warning"
                    data-csrf="{{ csrf_token('practice-delete') }}"
                >
                    <twig:ux:icon name="delete" />
                    Supprimer l'entraînement
                </button>

            </div>
	</div>
</div>

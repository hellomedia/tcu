{% extends '@admin/base.html.twig' %}

{% block head_stylesheets %}
    {{ parent() }}
    <style>
        .placeholder {
            visibility: hidden;
            width: 15px;
        }
        .date-header {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-top: 5px;
            margin-bottom: 15px;
        }
        .date {
            border: 1px solid #ddd;
            border-radius: 3px;
            padding: 15px;
        }
        .courts {
            h5 {
                text-align: center;
                white-space: nowrap;
            }
        }
        .court {
            margin-bottom: 30px;
        }
        .slots {
            margin-top: 15px;
            display: flex;
            flex-direction: column;
            gap: 3px;
        }
        .slot-row {
            height: 60px;
            .btn {
                svg {
                    width: 15px;
                }
            }
        }
        .slot-content {
            border: 1px dashed #ccc;
            .slot-row-placeholder & {
                border: 0;
                color: #bbb;
            }
        }
        .slot-content-inner,
        .slot-actions-inner {
            height: 100%;
            display: flex;
            flex-direction: row;
            align-items: center;
        }
        .slot-content-inner {
            justify-content: center;
            &.with-match {
                justify-content: space-between;
                padding-inline: 15px;
            }
        }
        .slot-actions-inner {
            justify-content: start;
        }
        .sides {
            display: flex;
            flex-direction: column;
        }
        .side {
            display: flex;
            gap: 10px;
            align-items: center;
        }
        .player-confirmation-indicator-link {
            flex: 0 0 10px;
        }
        .player-confirmation-indicator {
            display: block;
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background-color: #bbb;
            &.confirmed {
                background-color: green;
            }
            &.notified {
                background-color: blue;
            }
            &.changed {
                /* notified of another time : to notify again */
                background-color: #f59e0b;
            }
        }
        .results {
            td {
                padding-inline: 4px;
            }
            td:first-child {
                padding-left: 0;
            }
            td:last-child {
                padding-right: 0;
            }
        }
        .slot-actions {
            .btn {
                padding-inline: 3px;
                box-shadow: none;
                svg {
                    width: 24px;
                }
            }
        }

        /* POULE COLOUR : stripe on the left of a booked slot (confirmation dots are next to the names) */
        .slot-row.booked .slot-content {
            border-left: 5px solid var(--group-color, #ccc);
        }

        /* TOOLBAR : free slots only, poule legend / focus */
        .planning-toolbar {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 10px 24px;
            margin-bottom: 20px;
            font-size: 0.9rem;
        }
        .planning-toolbar .toolbar-label {
            color: #6c757d;
        }
        .planning-toolbar .free-toggle {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin: 0;
            font-weight: 500;
            cursor: pointer;
            input {
                margin: 0;
            }
        }
        .group-legend {
            display: inline-flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 6px;
        }
        .group-legend-item {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 3px 10px 3px 8px;
            border: 1px solid #dee2e6;
            border-radius: 999px;
            background: #fff;
            font-weight: 500;
            cursor: pointer;
            line-height: 1.3;
            &:hover {
                border-color: var(--group-color);
            }
            &.active {
                border-color: var(--group-color);
                box-shadow: inset 0 0 0 1px var(--group-color);
            }
            .swatch {
                width: 10px;
                height: 10px;
                border-radius: 2px;
                background: var(--group-color);
            }
            .remaining {
                color: #6c757d;
                font-weight: 400;
                font-size: 0.8rem;
            }
        }
        .planning-toolbar .toolbar-reset {
            all: unset;
            color: #6c757d;
            cursor: pointer;
            text-decoration: underline;
            font-size: 0.85rem;
        }

        /* DRAG & DROP : booked slot -> free slot */
        @media (min-width: 768px) {
            .dnd-enabled .slot-row.booked .slot-content {
                cursor: grab;
            }
        }
        .slot-row.dragging .slot-content {
            opacity: 0.4;
        }
        .dnd-enabled.dragging-active .slot-row.free .slot-content {
            border-style: solid;
            border-color: #adb5bd;
        }
        .slot-row.free.drop-target .slot-content {
            border-color: #2563eb;
            background: #eff6ff;
            .btn {
                visibility: hidden;
            }
        }
        .slot-row.free.drop-target .slot-content-inner::after {
            content: attr(data-drop-label);
            color: #2563eb;
            font-weight: 600;
            font-size: 0.85rem;
            position: absolute;
        }

        /* filtered rows fade out but keep their place: times stay aligned across courts */
        .slot-row.dimmed {
            opacity: 0.18;
            transition: opacity 0.15s;
        }
        .slot-row.dimmed .slot-actions {
            visibility: hidden;
        }
        .date.all-dimmed {
            opacity: 0.4;
        }

        /* LAYOUT */
        .planning {
            display: grid;
            gap: 30px;
            grid-template-columns: 1fr;
        }
        .date {
            overflow-x: auto; /* add scrollbar when necessary */
        }
        .courts {
            display: flex;
            flex-wrap: wrap;
        }
        .court {
            width: 100%;
            &.without-slots {
                display: none;
            }
        }
        .slot-row {
            display: grid;
            gap: 5px;
            grid-template-columns: 50px minmax(230px, 1fr) 30px;
            &.slot-row-placeholder {
                grid-template-columns: minmax(230px, 1fr);
            }
        }
        @media (min-width: 768px) {
            .planning {
                grid-template-columns: 1fr;
                &.court-count-1 {
                    grid-template-columns: repeat(2, 1fr);
                }
            }
            .courts {
                flex-wrap: nowrap;
            }
            .court {
                width: 100%; /* makes all items the same size no matter the content */
                margin-bottom: 0;
                &.without-slots {
                    display: block;
                }
            }
            .slot-row {
                grid-template-columns: 50px minmax(230px, 1fr) 50px;
                &.slot-row-placeholder {
                    grid-template-columns: minmax(230px, 1fr);
                }
                .btn {
                    visibility: hidden;
                }
                &:hover {
                    .btn {
                        visibility: visible;
                    }
                }
                .slot-content-inner {
                    position: relative;
                }
            }
        }
        @media (min-width: 1400px) {
            .planning {
                &.court-count-2 {
                    grid-template-columns: repeat(2, 1fr);
                }
            }
        }
    </style>
{% endblock %}

{% block content_title %}Planning{% endblock %}

{% block page_actions %}
{% endblock %}

{% block main %}

    <div data-controller="planning-filter" data-planning-filter-storage-key-value="{{ block('storage_key') }}">

        {% block toolbar %}
            <div class="planning-toolbar">
                <label class="free-toggle">
                    <input type="checkbox" data-planning-filter-target="freeOnly" data-action="planning-filter#toggleFreeOnly">
                    Créneaux libres uniquement
                </label>

                {% if groups is not empty %}
                    <div class="group-legend">
                        <span class="toolbar-label">Poules :</span>
                        {% for group in groups %}
                            {% set remaining = group.matchs|filter(m => not m.scheduled)|length %}
                            <button type="button"
                                class="group-legend-item"
                                style="--group-color: {{ group_color(group) }}"
                                data-group-id="{{ group.id }}"
                                data-planning-filter-target="group"
                                data-action="planning-filter#toggleGroup"
                                title="{{ remaining }} match{{ remaining > 1 ? 's' }} à programmer — cliquer pour ne voir que cette poule"
                            >
                                <span class="swatch"></span>
                                {{ group }}
                                {% if remaining > 0 %}
                                    <span class="remaining">{{ remaining }}</span>
                                {% endif %}
                            </button>
                        {% endfor %}
                    </div>
                {% endif %}

                <button type="button" class="toolbar-reset" data-planning-filter-target="reset" data-action="planning-filter#reset" hidden>
                    Tout afficher
                </button>
            </div>
        {% endblock %}

        <div class="planning {{ block('dnd_enabled') ? 'dnd-enabled' }}"
            data-controller="modal modal-confirm modal-remote-form{{ block('dnd_enabled') ? ' planning-dnd' }}"
            data-planning-filter-target="planning"
            data-planning-dnd-token-value="{{ csrf_token('move-booking') }}"
            data-planning-dnd-url-value="{{ path('admin_match_move_booking_to', {'id': 'MATCH', 'slot': 'SLOT'}) }}"
        >
            {% for date in dates %}
                {% include '@admin/planning/_date.html.twig' %}
            {% endfor %}

            {% include 'component/modal/_modal.html.twig' %}
            {% include 'component/modal/_icons_templates.html.twig' %}
        </div>

    </div>

{% endblock %}

{# localStorage key : the filters are remembered per page #}
{% block storage_key 'planning-filter' %}

{# drag & drop of booked slots onto free slots (not on past matches) #}
{% block dnd_enabled true %}
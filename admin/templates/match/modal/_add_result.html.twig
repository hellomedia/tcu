{# Important: Note the syntax with [] and only #}
{# Ignore global themes; use only EasyAdmin #}
{# important to avoid theme conflicts #}
{% form_theme form with ['@admin/form/form_theme.html.twig'] only %}

<turbo-frame id="modal-frame" data-turbo="true">{# data-turbo=true for easy-admin #}

    {{ form_start(form, {
        'attr': {
            'action': path('admin_match_add_result', {'id': match.id}),
            'data-controller': 'score-entry',
        }
    }) }}

        {% include '@admin/match/_result_table.html.twig' %}

        {{ form_rest(form) }}

        {% embed 'component/modal/_actions.html.twig' %}
            {% block submit_attributes %}data-score-entry-target="submit"{% endblock %}
        {% endembed %}
    
    </form>

</turbo-frame>

<div class="planning-secondary-actions hk-dropdown-container"
	data-controller="dropdown"
>
	<button type="button"
		class="hk-dropdown-button"
		data-action="dropdown#toggle"
	>
		<twig:ux:icon name="dots"/>
	</button>

	<div data-dropdown-target="menu" class="hk-dropdown-menu">
		<div class="hk-dropdown-inner">

			<a href="{{ path('admin_group_edit', {'entityId': group.id, 'referrer': path('admin_groups')}) }}"
				class="hk-dropdown-link"
			>
				<twig:ux:icon name="edit" />
				Modifier
			</a>

			<button type="button"
				class="hk-dropdown-link"
				formaction="{{ path('admin_groups_delete', {'id': group.id}) }}"
				data-action="modal-confirm#open"
				data-title="Supprimer la poule {{ group }}"
				data-html="<p>{{ group.matchs is not empty ? 'Attention, les matchs de la poule et les réservations associées seront supprimés!' : 'La poule sera supprimée.' }}</p>"
				data-button-label="Supprimer la poule"
				data-variant="warning"
				data-csrf="{{ csrf_token('delete-group') }}"
			>
				<twig:ux:icon name="delete" />
				Supprimer
			</button>

		</div>
	</div>
</div>

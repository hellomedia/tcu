{# Carte d'une poule : joueurs uniquement (page Poules). Les matchs : _group.html.twig (planning) #}
<div class="group" id="group-{{ group.id }}" style="--group-color: {{ group_color(group) }}">
    <div class="group-header">
        <h4>{% include '@admin/group/_swatch.html.twig' %}{{ group }}</h4>
        {% include '@admin/group/_card_actions.html.twig' %}
    </div>
    <div class="players">
        {% for player in group.playersByRanking %}
            <div class="player">{{ loop.index }}. {{ player.nameWithRanking(group.season) }}</div>
        {% else %}
            <div class="players-empty">Aucun joueur</div>
        {% endfor %}
    </div>
    {% include '@admin/group/_matchs_warnings.html.twig' with {'link': true} %}
</div>

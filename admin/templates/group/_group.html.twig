<div class="group" id="group-{{ group.id }}">
    <div class="group-header">
        <h4>{{ group }}</h4>    
        {% include '@admin/group/_secondary_actions.html.twig' %}
    </div>
    <div class="players">
        {% for player in group.playersByRanking %}
            <div class="player">{{ loop.index }}. {{ player.nameWithRanking(group.season) }}</div>
        {% endfor %}
    </div>
    <div class="matchs">
        <h5>Matchs</h5>
        {% for match in group.matchs %}
            {% include '@admin/group/_match_row.html.twig' %}
        {% else %}
            <form method="post" action="{{ path('admin_planning_group_generate_matchs', {'id': group.id}) }}">
                <button type="submit" class="btn btn-primary">
                    Générer les matchs
                </button>
                <input type="hidden" name="token" value="{{ csrf_token('generate-matchs') }}" />
            </form>
        {% endfor %}
    </div>
</div>

{% extends '@admin/base.html.twig' %}

{% block head_stylesheets %}
    {{ parent() }}
    <style>
        h4 {
            margin-bottom: 20px;
        }
        .group {
            border: 1px solid #ddd;
            border-radius: 3px;
            padding: 15px;
        }
        .group-header {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 0;
        }
        .players {
            display: flex;
            flex-direction: column;
            gap: 5px;
            margin-bottom: 30px;
        }
        .matchs {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .match {
            display: flex;
            flex-wrap: nowrap;
            justify-content: space-between;
            align-items: center;
            gap: 30px;
            min-height: 32px;
        }
        .booking {
            display: flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
        }
        .match-actions {
            .hk-dropdown-button svg {
                height: 22px;
                color: #999;
            }
            .hk-dropdown-button:hover svg {
                color: inherit;
            }
            .hk-dropdown-menu {
                right: 0;
            }
        }
        @media (min-width: 768px) {
            .match-actions .hk-dropdown-button {
                visibility: hidden;
            }
            .match:hover .match-actions .hk-dropdown-button,
            .match-actions:has(.open) .hk-dropdown-button {
                visibility: visible;
            }
        }

        /* LAYOUT */
        .groups {
            display: grid;
            gap: 30px;
        }
        @media (min-width: 768px) {
            .groups {
                grid-template-columns: 1fr 1fr;
            }
        }
    </style>
{% endblock %}

{% block content_title %}Planning des poules - {{ season }}{% endblock %}

{% block page_actions %}

{% endblock %}


{% block main %}

    <div class="groups" data-controller="modal modal-confirm modal-remote-form">
        {% for group in groups %}
            {% include '@admin/group/_group.html.twig' %}
        {% endfor %}

        {% include 'component/modal/_modal.html.twig' %}
        {% include 'component/modal/_icons_templates.html.twig' %}

    </div>

{% endblock %}
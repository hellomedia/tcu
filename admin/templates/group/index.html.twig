{% extends '@admin/base.html.twig' %}

{% block head_stylesheets %}
    {{ parent() }}
    <style>
        h4 {
            margin-bottom: 20px;
        }
        .group {
            border: 1px solid #ddd;
            border-radius: 3px;
            padding: 15px;
        }
        .group-header {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 0;
        }
        .players {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }
        .players-empty {
            color: var(--text-muted);
        }
        .group-warning {
            display: flex;
            align-items: baseline;
            gap: 6px;
            margin-top: 8px;
            padding: 6px 10px;
            border-radius: 4px;
            background: #fffbeb;
            color: #b45309;
            font-size: 0.85rem;
            font-weight: 500;
            a {
                color: inherit;
                text-decoration: underline;
            }
        }
        .group-swatch {
            display: inline-block;
            width: 12px;
            height: 12px;
            border-radius: 3px;
            vertical-align: -1px;
            margin-right: 8px;
            flex: 0 0 auto;
        }
        .group {
            border-left: 5px solid var(--group-color, #ddd);
        }

        /* LAYOUT */
        .groups {
            display: grid;
            gap: 30px;
        }
        @media (min-width: 768px) {
            .groups {
                grid-template-columns: 1fr 1fr;
            }
        }
        @media (min-width: 1200px) {
            .groups {
                grid-template-columns: 1fr 1fr 1fr;
            }
        }
    </style>
{% endblock %}

{% block content_title %}Poules - {{ season }}{% endblock %}

{% block page_actions %}
    <a class="btn btn-primary" href="{{ path('admin_group_new') }}">Créer Poule</a>
{% endblock %}

{% block main %}

    <div class="groups" data-controller="modal modal-confirm">
        {% for group in groups %}
            {% include '@admin/group/_card.html.twig' %}
        {% else %}
            <p>Aucune poule pour cette saison.</p>
        {% endfor %}

        {% include 'component/modal/_modal.html.twig' %}
        {% include 'component/modal/_icons_templates.html.twig' %}
    </div>

{% endblock %}

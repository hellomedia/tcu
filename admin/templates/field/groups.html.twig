{# Poules du joueur pour la saison sélectionnée dans l'admin (toutes les poules si pas de saison) #}
{% set season = field.customOptions.get('season') %}
{% set groups = season ? entity.instance.groupsForSeason(season) : field.value %}
<div class="entity-list">
	{% if groups|length > 0 %}
        {% for item in groups %}
            <a href="{{ path('admin_group_detail', {entityId: item.id}) }}" style="white-space: nowrap">
                <span class="group-swatch" style="display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 5px; vertical-align: -1px; background: {{ group_color(item) }}"></span>{{ item }}
            </a>
        {% endfor %}
    {% else %}
        <span class="badge badge-outline">{{ 'label.null'|trans({}, 'EasyAdminBundle') }}</span>
    {% endif %}
</div>

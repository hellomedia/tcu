{% extends '@admin/base.html.twig' %}

{#
    Page Dispos : inscrits aux interfacs de la saison sélectionnée, par poule (puis sans poule),
    état de leurs disponibilités, lien vers la grille de chacun (éditable par l'admin)
#}

{% block head_stylesheets %}
    {{ parent() }}
    <style>
        .dispo-intro {
            color: #6c757d;
            margin-bottom: 16px;
            max-width: 900px;
        }
        .dispo-counts {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 24px;
        }
        .dispo-section {
            margin-bottom: 28px;
            h4 {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-bottom: 8px;
                font-size: 1.05rem;
                font-weight: 600;
            }
            .swatch {
                width: 12px;
                height: 12px;
                border-radius: 3px;
                background: var(--group-color);
            }
        }
        .dispo-table {
            width: 100%;
            border-collapse: collapse;
            th, td {
                padding: 8px 10px;
                border-bottom: 1px solid #e9ecef;
                vertical-align: middle;
                text-align: left;
            }
            th {
                font-size: 0.8rem;
                text-transform: uppercase;
                letter-spacing: 0.04em;
                color: #6c757d;
            }
            .col-player { width: 28%; }
            .col-status { width: 16%; white-space: nowrap; }
            .col-soon { width: 16%; white-space: nowrap; }
            td.actions {
                text-align: right;
                white-space: nowrap;
            }
        }
        .dispo-muted {
            color: #6c757d;
            font-size: 0.85rem;
        }
        .dispo-remarks {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            font-size: 0.9rem;
        }
        .dispo-soon {
            color: #b91c1c;
            font-weight: 600;
        }
    </style>
{% endblock %}

{% block content_title %}Dispos{{ season ? ' - ' ~ season }}{% endblock %}

{% block page_actions %}{% endblock %}

{% block main %}
    {% set total = counts.complete + counts.partial + counts.none %}

    <p class="dispo-intro">
        Les joueurs indiquent leurs disponibilités dans leur espace « Mes interfacs ».
        Pour un joueur sans compte, ou qui a répondu autrement (email, téléphone), l'admin peut remplir sa grille.
    </p>

    {% if season is null %}
        <p>Aucune saison sélectionnée.</p>
    {% elseif total == 0 %}
        <p>Aucun inscrit aux interfacs pour {{ season }}.</p>
    {% else %}
        {% if not has_dates %}
            <div class="alert alert-info">Pas de dates à venir pour {{ season }} : rien à renseigner pour l'instant.</div>
        {% else %}
            <div class="dispo-counts">
                <span class="badge badge-secondary">{{ total }} inscrit{{ total > 1 ? 's' }}</span>
                <span class="badge badge-success">{{ counts.complete }} complète{{ counts.complete > 1 ? 's' }}</span>
                <span class="badge badge-warning">{{ counts.partial }} partielle{{ counts.partial > 1 ? 's' }}</span>
                <span class="badge badge-secondary">{{ counts.none }} sans réponse</span>
            </div>
        {% endif %}

        {% for section in sections %}
            <div class="dispo-section">
                {% if section.group %}
                    <h4 style="--group-color: {{ group_color(section.group) }}"><span class="swatch"></span>{{ section.group }}</h4>
                {% else %}
                    <h4>Sans poule</h4>
                {% endif %}

                <table class="dispo-table">
                    <thead>
                        <tr>
                            <th class="col-player">Joueur</th>
                            <th class="col-status">Dates renseignées</th>
                            <th class="col-soon">Bientôt</th>
                            <th>Remarques</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in section.rows %}
                            {% set registration = row.registration %}
                            {% set player = registration.player %}
                            {% set summary = row.summary %}
                            {% set badge = summary.status == 'complete' ? 'success' : (summary.status == 'partial' ? 'warning' : 'secondary') %}
                            <tr>
                                <td class="col-player">
                                    {{ player }}
                                    {% if player.user is null %}
                                        <br><span class="dispo-muted">pas de compte : grille à remplir par l'admin</span>
                                    {% endif %}
                                    {% if registration.status.value == 'pending' %}
                                        <br><span class="dispo-muted">inscription à confirmer</span>
                                    {% endif %}
                                </td>
                                <td class="col-status">
                                    {% if summary.total == 0 %}
                                        <span class="dispo-muted">—</span>
                                    {% else %}
                                        <span class="badge badge-{{ badge }}">{{ summary.answered }}/{{ summary.total }}</span>
                                        {% if summary.partial > 0 %}
                                            <span class="dispo-muted">+{{ summary.partial }} partielle{{ summary.partial > 1 ? 's' }}</span>
                                        {% endif %}
                                    {% endif %}
                                </td>
                                <td class="col-soon">
                                    {# dates without an answer in the next AvailabilityGrid::SOON (2 months) #}
                                    {% if summary.missingSoon > 0 %}
                                        <span class="dispo-soon">{{ summary.missingSoon }} à renseigner</span>
                                    {% elseif summary.total > 0 %}
                                        <span class="dispo-muted">ok</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if registration.availabilities %}
                                        <span class="dispo-remarks" title="{{ registration.availabilities }}">{{ registration.availabilities }}</span>
                                    {% endif %}
                                </td>
                                <td class="actions">
                                    <a class="btn btn-sm btn-default" href="{{ path('admin_registration_availabilities', {'id': registration.id, 'from': from}) }}">
                                        Voir / modifier
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endfor %}
    {% endif %}
{% endblock %}

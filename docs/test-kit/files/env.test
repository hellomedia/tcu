# Goes to .env.test at the project root: merge these lines into the one the phpunit recipe created.

# ADAPT: host env vars of a host-dependent app, with .test names. Requests never leave the process,
# but generated URLs (emails) should not look like prod.
HOST="tcu.test"
HOST_ADMIN="admin.tcu.test"
# Never send emails from tests. ADAPT: check `APP_ENV=test bin/console debug:dotenv MAILER_DSN`.
MAILER_DSN=null://null

# DATABASE_URL goes in .env.test.local (git-ignored), like .env.local for dev.
# Doctrine appends "_test" to the database name (doctrine recipe, when@test dbname_suffix).

# https://phpstan.org/config-reference
# Run: vendor/bin/phpstan analyse
# Known errors are in phpstan-baseline.neon (regenerate with --generate-baseline once some are fixed).
includes:
    - phpstan-baseline.neon

parameters:
    level: 6
    paths:
        - bin/
        - config/
        - public/
        - src/
        - packs/
        - admin/src/
    excludePaths:
        - config/reference.php # generated by Symfony

    # https://github.com/phpstan/phpstan-symfony#configuration
    # The admin container is a superset of the site one (admin/config is loaded on top of config/).
    # It is compiled when the admin is visited in dev, or with: HTTP_HOST=admin.tcu.kimchi bin/console cache:warmup
    symfony:
        containerXmlPath: var/cache/admin/dev/App_KernelDevDebugContainer.xml

    # https://github.com/phpstan/phpstan-doctrine#configuration
    doctrine:
        objectManagerLoader: config/phpstan/object-manager.php
        # A non-nullable column may be backed by a nullable property: entities are built
        # empty (new Player()) and filled by forms, the validator enforces the value.
        allowNullablePropertyForRequiredField: true
